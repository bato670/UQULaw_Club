<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>نادي الدراسات القضائية والأنظمة — جامعة أم القرى</title>
<link href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Cairo:wght@400;700&family=Tajawal:wght@400;700&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&family=Almarai:wght@400;700&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--teal:#0E5E5B;--deep:#083B3A;--gold:#A9844B;--paper:#fff;--card:#fff;--ink:#12302F;--mute:#56706E;--line:#DAD5C6;--ph:#CFE0DC}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans Arabic",system-ui,sans-serif;line-height:1.9;padding-bottom:env(safe-area-inset-bottom)}
h1,h2,h3,h4{font-family:"Reem Kufi","IBM Plex Sans Arabic",sans-serif;line-height:1.4}a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.wrap{max-width:1120px;margin:auto;padding:0 20px}.mute{color:var(--mute)}
.bars{display:flex;align-items:flex-end;gap:4px;height:34px}.bars i{width:4px;background:var(--gold);border-radius:2px}
.bars i:nth-child(1),.bars i:nth-child(7){height:30%}.bars i:nth-child(2),.bars i:nth-child(6){height:55%}.bars i:nth-child(3),.bars i:nth-child(5){height:85%}.bars i:nth-child(4){height:100%}
.vl{background:repeating-linear-gradient(90deg,transparent 0 22px,rgba(169,132,75,.16) 22px 23px)}
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top)}
.nav{display:flex;align-items:center;gap:20px;height:66px}.brand{display:flex;gap:12px;align-items:center;font:700 15px/1.2 "Reem Kufi"}.brand small{display:block;font:400 12px "IBM Plex Sans Arabic";color:var(--mute)}
nav ul{display:flex;gap:20px;list-style:none;padding:0;margin-inline-start:auto;font-size:15px}nav a{padding:6px 0;border-bottom:2px solid transparent}
.nav-actions{display:flex;align-items:center;gap:8px;margin-inline-start:4px}.nav-icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--line);border-radius:11px;background:#fff;color:var(--ink);transition:.2s}.nav-icon:hover{background:var(--teal);color:#fff;border-color:var(--teal);transform:translateY(-1px)}.nav-icon svg{width:19px;height:19px}.nav-icon.login svg{transform:scaleX(-1)}.nav-icon.x svg{width:18px;height:18px}
nav a:hover,body[data-r=events] a[href="/events"],body[data-r=news] a[href="/news"],body[data-r=articles] a[href="/articles"],body[data-r=library] a[href="/library"],body[data-r=reports] a[href="/reports"],body[data-r=about] a[href="/about"]{border-color:var(--gold)}
.sf{display:flex}.sf input{width:130px;border-radius:99px 0 0 99px}.sf button,.menu{border:1px solid var(--line);background:none;color:var(--ink);font:inherit;font-size:14px;padding:4px 14px;cursor:pointer}.sf button{border-radius:0 99px 99px 0}.menu{display:none;border-radius:10px;margin-inline-start:auto}
@media(max-width:900px){.nav-actions{margin-inline-start:auto}.nav-icon{width:36px;height:36px}nav ul{display:none;position:absolute;top:66px;inset-inline:0;background:var(--paper);flex-direction:column;padding:10px 20px 18px;border-bottom:1px solid var(--line);gap:2px}nav ul.open{display:flex}.menu{display:block}.sf input{width:90px}}
input,select,textarea{font:inherit;border:1px solid var(--line);border-radius:10px;padding:9px 12px;background:var(--paper);color:var(--ink);width:100%}
.hero{background:#fff;color:var(--ink);border-bottom:1px solid var(--line);position:relative;overflow:hidden;padding:70px 0 90px}.hero .vl{position:absolute;inset:0}
.hg{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center}.hero h1{font-size:clamp(38px,6.4vw,78px);margin-bottom:14px}.hero p{max-width:46ch;color:var(--mute);white-space:pre-wrap}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.btn{border-radius:12px;padding:11px 24px;font:600 16px "IBM Plex Sans Arabic";border:1px solid var(--gold);cursor:pointer;background:transparent;color:inherit}.btn.g{background:var(--gold);color:#1B1408}
.col{position:relative;height:400px}.col>*{position:absolute;object-fit:cover}.col .a{inset-inline-start:0;top:20px;width:72%;height:290px;border-radius:200px 200px 0 0}.col .b{inset-inline-end:0;bottom:0;width:52%;height:200px;border-radius:0 90px 0 0;border:6px solid #fff}
@media(max-width:860px){.hg{grid-template-columns:1fr}.col{height:340px}}
.ph{background:repeating-linear-gradient(90deg,var(--ph) 0 14px,color-mix(in srgb,var(--ph) 80%,var(--teal)) 14px 16px)}img{max-width:100%;display:block}
section{padding:60px 0}.head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:28px;border-bottom:1px solid var(--line);padding-bottom:12px}.head h2{font-size:clamp(26px,3.6vw,38px)}.more{color:var(--teal);font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px}
.card,.art{box-shadow:0 1px 0 rgba(0,0,0,.02);position:relative;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:4px 36px 4px 4px;overflow:hidden;transition:transform .25s}.card:hover{transform:translateY(-4px)}.art{border-radius:16px}
.card img,.card .ph,.art img,.art .ph{width:100%;height:190px;object-fit:cover}.bd{padding:16px 18px 20px}.meta{color:var(--gold);font-size:13px;font-weight:600}.bd h3{font-size:19px}.bd p{color:var(--mute);font-size:14.5px;line-height:1.8}
.arrow{position:absolute;inset-inline-end:14px;bottom:14px;width:36px;height:36px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center}.card .bd{padding-bottom:56px}
.row{display:flex;align-items:center;justify-content:space-between;margin-top:12px;padding-top:10px;border-top:1px solid var(--line)}
.dl{display:inline-block;background:var(--teal);color:#fff;border:0;border-radius:99px;padding:3px 14px;font:inherit;font-size:13px}.sh{display:flex;gap:6px}.sh button{width:30px;height:30px;border-radius:50%;border:1px solid var(--line);background:none;color:var(--ink);font:600 11px "IBM Plex Sans Arabic";cursor:pointer}.sh button:hover{background:var(--gold);color:#1B1408}
.ident{background:#fff;color:var(--ink);position:relative;border-block:1px solid var(--line)}.ident .vl{position:absolute;inset:0}.ident .c3{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:36px}.ident h3{font-size:28px;color:var(--teal)}.ident p,.body{white-space:pre-wrap}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}.st{padding:24px 8px;text-align:center;border-inline-start:1px solid var(--line)}.st b{display:block;font:700 44px "Reem Kufi";color:var(--teal)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.chip{border:1px solid var(--line);background:none;color:var(--ink);border-radius:99px;padding:3px 16px;font:inherit;cursor:pointer}.chip.on{background:var(--teal);color:#fff;border-color:var(--teal)}
.join{display:grid;grid-template-columns:.8fr 1.2fr;gap:36px}form{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:14px}.f{display:flex;flex-direction:column;gap:4px;font-size:14px;font-weight:500}.f.w,.safe{grid-column:1/-1}.safe{font-size:13px;color:var(--mute)}.drop{border:2px dashed var(--gold);border-radius:14px;padding:16px;text-align:center;color:var(--mute);cursor:pointer;font-size:14px}
@media(max-width:860px){.join{grid-template-columns:1fr}}@media(max-width:600px){form{grid-template-columns:1fr}}
/* detail */
.dh{background:#fff}.dh>img{width:100%;height:min(48vw,440px);object-fit:cover}.dh h1{color:var(--ink);font-size:clamp(32px,5.5vw,60px);padding:28px 0 8px;max-width:20ch}
.dt{max-width:760px;margin:40px auto;font-size:18px}.dt .body{margin-top:18px}.dt .cover{border-radius:16px;margin:18px 0;width:100%}
.ev{max-width:1000px;margin:40px auto;padding:0 20px;font-size:18px;display:flow-root}.ev .body{margin:0 0 26px}.cut{float:inline-end;width:220px;margin:0 28px 10px;filter:drop-shadow(0 12px 16px rgba(0,0,0,.25))}.cut.s{width:140px}.cut.l{width:320px}.cut.start{float:inline-start}
.wide{width:100vw;position:relative;inset-inline-start:50%;margin-inline-start:-50vw;height:min(46vw,420px);object-fit:cover;margin-block:24px;clear:both}.q{clear:both;border-inline-start:4px solid var(--gold);padding:4px 20px;margin:26px 0;font:700 26px/1.6 "Reem Kufi";color:var(--teal)}
.gal{clear:both;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.gal img{width:100%;height:200px;object-fit:cover}.gal img:first-child{grid-column:span 2;height:410px;grid-row:span 2}
@media(max-width:700px){.cut,.cut.l{width:130px;margin:0 14px 6px}.gal img:first-child{grid-column:span 1;height:200px;grid-row:auto}}
.kv{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.kv span{border:1px solid var(--line);border-radius:12px;padding:4px 14px}.kv b{font:700 22px "Reem Kufi";color:var(--teal);margin-inline-end:6px}
/* structure */
.node{border-inline-start:2px solid var(--gold);padding:4px 18px;margin:16px 0}.node h4{font-size:20px;color:var(--teal)}.node .node{border-color:var(--line)}.ppl{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin:8px 0}
.person{display:flex;gap:12px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:8px 12px}.person span{display:block;color:var(--mute);font-size:13px}.ava{width:48px;height:48px;border-radius:50%;object-fit:cover;background:var(--teal);flex:none}
footer{background:#fff;color:var(--mute);border-top:1px solid var(--line);padding:36px 0;font-size:14px}footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}footer .q2{opacity:.6;font-size:13px}
#toast{position:fixed;bottom:calc(24px + env(safe-area-inset-bottom));left:50%;transform:translate(-50%,30px);background:var(--ink);color:var(--paper);padding:10px 22px;border-radius:99px;opacity:0;transition:.3s;z-index:50;pointer-events:none}#toast.on{opacity:1;transform:translate(-50%,0)}
.car{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}.car::-webkit-scrollbar{display:none}.car>*{flex:0 0 min(86%,320px);scroll-snap-align:start}
.dots{display:flex;gap:8px;justify-content:center;margin-top:16px}.dots i{width:10px;height:10px;border-radius:50%;background:#E3E3DC;transition:.25s}.dots i.on{width:26px;border-radius:6px;background:var(--teal)}
.fe{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}.fe img,.fe .ph{width:100%;height:340px;object-fit:cover;border-radius:16px}.fe h3{font-size:26px;margin-bottom:8px}
.chip2{display:inline-flex;border:1px solid var(--line);border-radius:8px;padding:0 10px;font-size:13px;margin:0 0 6px;margin-inline-end:8px;color:var(--mute)}
.nl{display:grid;grid-template-columns:1fr 1fr;gap:20px}.nrow{display:flex;gap:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:16px}.nrow img,.nrow .ph{width:120px;height:130px;object-fit:cover;border-radius:10px;flex:none}.nrow .big{width:100%!important;height:260px!important}.nrow h3{font-size:18px}
.art .bd>.sh{margin-bottom:8px}.att-l{margin-top:34px;border-top:1px solid var(--line);padding-top:16px}
@media(max-width:860px){.fe,.nl{grid-template-columns:1fr}.fe img,.fe .ph{height:240px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

footer{background:#083B3A;color:#cfe0dc;border-top:3px solid var(--gold);padding:46px 0 18px}footer .wrap{display:block}footer p{color:#cfe0dc}.fcols>div{min-width:0}.fcols a{display:flex;align-items:center;gap:7px;padding:4px 0;color:#e8f2f0;transition:.18s}.fcols a:hover{color:#fff;transform:translateX(-3px)}.fbar{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.16);padding-top:18px}.ficons{display:flex;gap:8px}.fi{width:38px;height:38px;border:1px solid rgba(255,255,255,.2);border-radius:11px;display:grid;place-items:center;color:#fff!important;padding:0!important}.fi svg{width:18px;height:18px}.fupd{font-size:12px;color:rgba(207,224,220,.75);margin-top:12px}
.fcols{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px;margin-bottom:28px}.fcols h4{color:#fff;font-size:16px;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid rgba(255,255,255,.18);position:relative}.fcols h4:after{content:"";position:absolute;inset-inline-start:0;bottom:-1px;width:44px;height:3px;background:var(--gold)}
.fl a{display:flex;align-items:center;gap:8px;color:#cfe0dc;padding:5px 0;text-decoration:none}.fl a:hover{color:#fff}.fl a:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--gold);flex:none}.fl svg,.fch svg{width:13px;height:13px;opacity:.7}
.fch a{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(255,255,255,.3);border-radius:99px;padding:2px 14px;margin:0 0 8px 8px;color:#fff;text-decoration:none;font-size:13px}.fch a:hover{background:var(--gold);border-color:var(--gold)}
.fbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.18);padding-top:18px}.ficons{display:flex;gap:10px}.fi{width:40px;height:40px;border:1px solid rgba(255,255,255,.35);border-radius:10px;display:grid;place-items:center;color:#fff}.fi:hover{background:var(--gold);border-color:var(--gold)}.fi svg{width:19px;height:19px}.fupd{font-size:12px;opacity:.7;margin-top:12px}
</style>
</head>
<body data-r="home">
<header><div class="wrap nav">
<a href="/" class="brand"><span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span>نادي الدراسات القضائية والأنظمة<small>جامعة أم القرى</small></span></a>
<button class="menu" onclick="document.querySelector('nav ul').classList.toggle('open')">القائمة</button>
<nav><ul onclick="this.classList.remove('open')"><li><a href="/">الرئيسية</a></li><li><a href="/events">الفعاليات</a></li><li><a href="/news">الأخبار</a></li><li><a href="/articles">المقالات</a></li><li><a href="/library">مكتبة النادي</a></li><li><a href="/reports">تقارير النادي</a></li><li><a href="/about">عن النادي</a></li></ul></nav>
<div class="nav-actions" aria-label="روابط المنصة"><a class="nav-icon x" href="https://x.com/uqu_law_club?s=11" target="_blank" rel="noopener" aria-label="منصة X" title="منصة X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><a class="nav-icon login" href="admin.html" aria-label="تسجيل الدخول" title="تسجيل الدخول"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></a></div>
<form class="sf" style="display:flex;background:none;border:0;padding:0;border-radius:0" onsubmit="event.preventDefault();var v=this.q.value.trim();if(v)go('/search/'+encodeURIComponent(v))"><input name="q" placeholder="بحث" aria-label="بحث"><button>بحث</button></form>
</div></header>
<main id="app"></main>
<footer><div class="wrap"><div class="fcols" id="fcols"></div><div class="fbar"><span id="fnote">نادي الدراسات القضائية والأنظمة · جامعة أم القرى</span><span class="ficons"><a class="fi" href="https://x.com/uqu_law_club?s=11" target="_blank" rel="noopener" aria-label="حساب النادي على منصة X" title="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><a class="fi" href="admin.html" aria-label="تسجيل الدخول" title="تسجيل الدخول"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="transform:scaleX(-1)"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></a></span></div><div class="fupd" id="fupd"></div></div></footer>
<div id="toast" role="status"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js" crossorigin="anonymous"></script>
<script>
/* ===== الإعداد: ضعي بيانات مشروع Supabase (المفتاح العام anon فقط) ===== */
const SB_URL='https://dsinztikwvuqhhwrhisg.supabase.co', SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRzaW56dGlrd3Z1cWhod3JoaXNnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4NTQ2MDcsImV4cCI6MjEwNjQzMDYwN30.MhBz5vD_s4u87y6c0tz1LgPtx18sjuEir0tju0f-ieQ';
/* صورتا العضو البديلتان: ارفعيهما إلى bucket اسمه media وضعي رابطيهما هنا */
const AVATAR={students:'',female_students:''};
if(/YOUR_SUPABASE/.test(SB_URL+SB_KEY)){document.getElementById('app').innerHTML='<div style="padding:48px 20px;text-align:center;direction:rtl;font-family:sans-serif"><h2>⚠️ لم يتم ربط Supabase بعد</h2><p>ضعي Project URL و anon key في أول السكربت (السطر الذي يبدأ بـ SB_URL).</p></div>';throw new Error('Supabase keys not set')}
const db=supabase.createClient(SB_URL,SB_KEY),app=document.getElementById('app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fd=d=>d?new Date(d).toLocaleDateString('ar-SA',{year:'numeric',month:'long',day:'numeric',calendar:'gregory'}):'';
const img=(u,c='')=>u?`<img class="${c}" src="${esc(u)}" alt="" loading="lazy">`:`<div class="ph ${c}"></div>`;
const toast=m=>{const t=document.getElementById('toast');t.textContent=m;t.classList.add('on');clearTimeout(window._t);window._t=setTimeout(()=>t.classList.remove('on'),2200)};
const ok=r=>{if(r.error)throw r.error;return r.data};const FNT=['Cairo','Tajawal','Amiri','Noto Naskh Arabic','Almarai','Reem Kufi','Aref Ruqaa'];
const rt=s=>{let h=esc(s);h=h.replace(/\*\*([\s\S]+?)\*\*/g,'<b>$1</b>');h=h.replace(/\{c:(#[0-9a-fA-F]{3,8})\}([\s\S]+?)\{\/c\}/g,'<span style="color:$1">$2</span>');return h.replace(/\{f:([\w ]+)\}([\s\S]+?)\{\/f\}/g,(m,f,t)=>FNT.includes(f)?`<span style="font-family:'${f}',sans-serif">${t}</span>`:t)};
const SAFE=u=>/^(https?:\/\/|mailto:|tel:|\/|#)/i.test(u||'')?u:'#',isx=u=>/^https?:/i.test(u||'');
const EXI='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>';
async function foot(){try{const r=await db.from('site_content').select('*').eq('key','footer').maybeSingle().then(ok);if(!r)return;const v=typeof r.value=='string'?JSON.parse(r.value):r.value;
const cols=(v.cols&&v.cols.length)?v.cols:[{title:'روابط مهمة',type:'links',links:[{label:'المقالات',url:'#/articles'},{label:'مكتبة النادي',url:'#/library'},{label:'الفعاليات',url:'#/events'}]},{title:'عن النادي',type:'links',links:[{label:'نبذة عن النادي',url:'#/about'},{label:'الهيكلة والأعضاء',url:'#/about'}]},{title:'تواصل',type:'text',text:'يمكنك التواصل مع نادي الدراسات القضائية والأنظمة عبر حسابه الرسمي.'}];document.getElementById('fcols').innerHTML=cols.map(c=>`<div><h4>${esc(c.title)}</h4>${c.type=='text'?`<p>${rt(c.text||'')}</p>`:`<div class="${c.type=='chips'?'fch':'fl'}">${(c.links||[]).map(l=>`<a href="${esc(SAFE(l.url))}"${isx(l.url)?' target="_blank" rel="noopener"':''}>${esc(l.label)}${isx(l.url)?EXI:''}</a>`).join('')}</div>`}</div>`).join('');
if(v.note)document.getElementById('fnote').textContent=v.note;if(v.updated)document.getElementById('fupd').textContent='تاريخ آخر تحديث: '+fd(v.updated)}catch(e){console.error(e)}}

const pub=(t,n=100)=>db.from(t).select('*').eq('status','published').order('published_at',{ascending:false}).limit(n).then(ok);
const TT={events:'الفعاليات',news:'الأخبار',articles:'المقالات',library:'مكتبة النادي',reports:'تقارير النادي'};
const DK={events:'event_date',news:'news_date'};
const site=async()=>{const rows=await db.from('site_content').select('*').then(ok);const out=Object.fromEntries(rows.map(r=>[r.key,r.value]));applySiteTypography(out.typography);return out};
const applySiteTypography=v=>{try{const x=typeof v=='string'?JSON.parse(v):v;if(!x)return;const root=document.documentElement;if(x.font)root.style.setProperty('--site-font',JSON.stringify(x.font).slice(1,-1));if(x.textColor)root.style.setProperty('--site-text',x.textColor);if(x.headingColor)root.style.setProperty('--site-heading',x.headingColor);if(x.bold)root.style.setProperty('--site-weight','700');else root.style.setProperty('--site-weight','400');document.body.style.fontFamily=x.font?`'${x.font}',system-ui,sans-serif`:'';document.body.style.color=x.textColor||'';document.querySelectorAll('h1,h2,h3,h4').forEach(el=>{if(x.font)el.style.fontFamily=`'${x.font}',system-ui,sans-serif`;if(x.headingColor)el.style.color=x.headingColor;if(x.bold)el.style.fontWeight='700'})}catch(e){console.warn('typography',e)}};
const empty=()=>`<p class="mute">لا يوجد محتوى منشور بعد.</p>`;
const chip=t=>t?`<span class="chip2">${t}</span>`:'';
const dots=n=>`<div class="dots">${Array.from({length:n},(_,i)=>`<i class="${i?'':'on'}"></i>`).join('')}</div>`;
function carDots(){document.querySelectorAll('.cw').forEach(w=>{const c=w.querySelector('.car'),d=w.querySelectorAll('.dots i');if(!c||!d.length)return;c.onscroll=()=>{const k=c.children.length,r=Math.abs(c.scrollLeft)/((c.scrollWidth-c.clientWidth)||1),i=Math.round(r*(k-1));d.forEach((x,j)=>x.classList.toggle('on',j==i))}})}
const carSec=(title,t,rows,fn)=>`<section><div class="wrap cw"><div class="head"><h2>${title}</h2><a class="more" href="/${t}">عرض الكل</a></div>${rows.length?`<div class="car">${rows.map(fn).join('')}</div>${dots(rows.length)}`:empty()}</div></section>`;
const feat=r=>`<div class="fe"><div>${img(r.cover_url)}</div><div><h3>${esc(r.title)}</h3><p class="mute">${esc(r.excerpt)}</p><p style="margin:10px 0">${chip(esc(r.location))}${chip(esc(fd(r.event_date||r.published_at)))}</p><a class="btn g" href="/events/${esc(r.slug)}">قراءة المزيد</a></div></div>`;
const featSec=rows=>rows.length?`<section><div class="wrap"><div class="head"><h2>أبرز الفعاليات</h2><a class="more" href="/events">عرض الكل</a></div><div id="fsl">${feat(rows[0])}</div>${rows.length>1?`<div class="dots" id="fdots">${rows.map((_,i)=>`<i class="${i?'':'on'}" data-i="${i}" style="cursor:pointer"></i>`).join('')}</div>`:''}</div></section>`:'';
const rd=(t,r)=>`<a class="btn g" style="padding:4px 16px;font-size:14px" href="/${t}/${esc(r.slug)}">قراءة المزيد</a>`;
const nrow=r=>`<div class="nrow">${img(r.cover_url)}<div><a href="/news/${esc(r.slug)}"><h3>${esc(r.title)}</h3></a><p>${chip(esc(fd(r.news_date||r.published_at)))}</p><div class="row" style="border:0;margin:0;padding:0">${share('news',r)}${rd('news',r)}</div></div></div>`;
const newsLayout=rows=>rows.length?`<div class="nl"><div class="nrow" style="flex-direction:column">${img(rows[0].cover_url,'big')}<a href="/news/${esc(rows[0].slug)}"><h3>${esc(rows[0].title)}</h3></a><p>${chip(esc(fd(rows[0].news_date||rows[0].published_at)))}</p><div class="row" style="border:0;margin:0;padding:0">${share('news',rows[0])}${rd('news',rows[0])}</div></div><div>${rows.slice(1,4).map(nrow).join('')}</div></div>`:empty();
const newsSec=rows=>`<section><div class="wrap"><div class="head"><h2>الأخبار</h2><a class="more" href="/news">عرض الكل</a></div>${newsLayout(rows)}</div></section>`;
const libCard=x=>`<article class="art">${img(x.cover_url)}<div class="bd"><span class="meta">${esc(x.category)}${x.year?' · '+x.year:''}</span><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p><div class="row">${dl(x.file_url)||'<span></span>'}</div></div></article>`;
const repCard=x=>`<a class="card" href="/reports/${esc(x.slug)}">${img(x.cover_url)}<div class="bd"><span class="meta">${x.year||''}</span><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p></div><span class="arrow">←</span></a>`;
const atts=r=>(r.attachments||[]).length?`<div class="att-l"><h3>المرفقات والروابط</h3>${r.attachments.map(a=>a.type=='text'?`<p class="body">${rt(a.value)}</p>`:a.type=='image'?`<figure style="margin:14px 0"><img src="${esc(a.value)}" alt="" style="border-radius:12px;width:100%"><figcaption class="mute">${esc(a.label)}</figcaption></figure>`:`<p><a class="dl" href="${esc(a.value)}" target="_blank" rel="noopener">${a.type=='file'?'تحميل':'فتح'}</a> ${esc(a.label)}</p>`).join('')}</div>`:'';
const link=(t,r)=>`${location.origin}${location.pathname.replace(/404\.html$/,'')}#/${t}/${r.slug}`;
const share=(t,r)=>{const u=esc(link(t,r)),n=esc(r.title);return `<div class="sh" aria-label="مشاركة">${[['wa','WA','واتساب'],['x','X','X'],['in','in','لينكدإن'],['cp','رابط','نسخ الرابط']].map(([k,l,a])=>`<button data-sh="${k}" data-u="${u}" data-t="${n}" aria-label="${a}">${l}</button>`).join('')}</div>`};
document.addEventListener('click',e=>{const b=e.target.closest('[data-sh]');if(!b)return;const u=encodeURIComponent(b.dataset.u),t=encodeURIComponent(b.dataset.t),k=b.dataset.sh;
if(k=='cp'){(navigator.clipboard?navigator.clipboard.writeText(b.dataset.u):Promise.reject()).catch(()=>{}).finally(()=>toast('تم نسخ الرابط'))}
else open({wa:`https://wa.me/?text=${t}%20${u}`,x:`https://twitter.com/intent/tweet?text=${t}&url=${u}`,in:`https://www.linkedin.com/sharing/share-offsite/?url=${u}`}[k],'_blank','noopener')});
const card=(t,r)=>`<a class="card" href="/${t}/${esc(r.slug)}">${img(r.cover_url)}<div class="bd"><span class="meta">${esc(fd(r[DK[t]]||r.published_at))}${r.category?' · '+esc(r.category):''}</span><h3>${esc(r.title)}</h3><p>${esc(r.excerpt)}</p></div><span class="arrow">←</span></a>`;
const artCard=r=>`<article class="art"><a href="/articles/${esc(r.slug)}">${img(r.cover_url)}</a><div class="bd">${share('articles',r)}<h3><a href="/articles/${esc(r.slug)}">${esc(r.title)}</a></h3><p>${r.author?'الكاتب: '+esc(r.author):''}${r.reviewer?'<br>المدقق: '+esc(r.reviewer):''}</p><p>${chip(esc(fd(r.published_at)))}</p><div class="row" style="gap:8px"><a class="btn g" style="padding:4px 16px;font-size:14px" href="/articles/${esc(r.slug)}">قراءة</a>${r.file_url?`<a class="btn" style="padding:4px 16px;font-size:14px;color:var(--ink);border-color:var(--line)" href="${esc(r.file_url)}" download target="_blank" rel="noopener">تحميل</a>`:''}</div></div></article>`;
const sec=(title,t,rows,fn)=>`<section><div class="wrap"><div class="head"><h2>${title}</h2><a class="more" href="/${t}">عرض الكل</a></div>${rows.length?`<div class="grid">${rows.map(fn).join('')}</div>`:empty()}</div></section>`;
const head=t=>`<section><div class="wrap"><div class="head"><h2>${TT[t]}</h2></div>`;
const body=s=>`<div class="body">${rt(s)}</div>`;
const dl=u=>u?`<a class="dl" href="${esc(u)}" download target="_blank" rel="noopener">تحميل</a>`:'';
const ava=m=>`<img class="ava" src="${esc(m.photo_url||AVATAR[m.section]||'data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><circle cx="24" cy="18" r="8" fill="#fff"/><path d="M8 46c0-12 7-18 16-18s16 6 16 18z" fill="#fff"/></svg>'))}" alt="">`;

const pages={
async home(){
  const [ev,nw,ar,lb,rp,st,sc]=await Promise.all([pub('events',5),pub('news',4),pub('articles',8),pub('library_items',8),pub('reports',6),db.from('site_stats').select('*').single().then(ok),site()]);
  const c=ev.filter(e=>e.cover_url);
  app.innerHTML=`<div class="hero"><div class="vl"></div><div class="wrap hg"><div><h1>النادي له ذاكرة</h1>${sc.hero_intro?`<p>${esc(sc.hero_intro)}</p>`:''}<div class="btns"><a class="btn g" href="/events">استعرض الفعاليات</a><button class="btn" onclick="document.getElementById('join').scrollIntoView()">اطلب الانضمام</button></div></div>
  <div class="col" aria-hidden="true">${c[0]?`<img class="a" src="${esc(c[0].cover_url)}" alt="">`:'<div class="ph a"></div>'}${c[1]?`<img class="b" src="${esc(c[1].cover_url)}" alt="">`:'<div class="ph b"></div>'}</div></div></div>`
  +featSec(ev)+newsSec(nw)+carSec('أحدث المقالات','articles',ar,artCard)+(lb.length?carSec('مكتبة النادي','library',lb,libCard):'')+(rp.length?carSec('تقارير النادي','reports',rp,repCard):'')
  +(sc.vision||sc.mission||sc.goals?`<section class="ident"><div class="vl"></div><div class="wrap c3">${[['رؤيتنا','vision'],['رسالتنا','mission'],['أهدافنا','goals']].filter(x=>sc[x[1]]).map(x=>`<div><h3>${x[0]}</h3><p>${esc(sc[x[1]])}</p></div>`).join('')}</div></section>`:'')
  +`<section><div class="wrap"><div class="head"><h2>النادي بالأرقام</h2></div><div class="stats">${[['events','فعالية'],['news','خبر'],['articles','مقال'],['reports','تقرير'],['members','عضو']].map(([k,l])=>`<div class="st"><b>${st[k]}</b>${l}</div>`).join('')}</div></div></section>`+await joinSec();
  const fx=document.getElementById('fdots');if(fx)fx.onclick=e=>{const i=e.target.dataset.i;if(i==null)return;document.getElementById('fsl').innerHTML=feat(ev[i]);fx.querySelectorAll('i').forEach((x,j)=>x.classList.toggle('on',j==+i))};
},
async events(p){if(p[1])return detail('events',p[1]);const r=await pub('events');app.innerHTML=head('events')+(r.length?`<div class="grid">${r.map(x=>card('events',x)).join('')}</div>`:empty())+'</div></section>'},
async news(p){if(p[1])return detail('news',p[1]);const r=await pub('news');app.innerHTML=head('news')+newsLayout(r.slice(0,4))+(r.length>4?`<div class="grid" style="margin-top:20px">${r.slice(4).map(x=>card('news',x)).join('')}</div>`:'')+'</div></section>'},
async articles(p){if(p[1])return detail('articles',p[1]);const r=await pub('articles');app.innerHTML=head('articles')+(r.length?`<div class="grid">${r.map(artCard).join('')}</div>`:empty())+'</div></section>'},
async library(){const r=await pub('library_items'),cats=[...new Set(r.map(x=>x.category).filter(Boolean))];
  const draw=c=>`<div class="grid">${r.filter(x=>!c||x.category==c).map(x=>`<article class="art">${img(x.cover_url)}<div class="bd"><span class="meta">${esc(x.category)}${x.year?' · '+x.year:''}</span><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p><div class="row">${dl(x.file_url)}</div></div></article>`).join('')}</div>`;
  app.innerHTML=head('library')+(r.length?`<div class="chips">${['',...cats].map(c=>`<button class="chip${c?'':' on'}" data-c="${esc(c)}">${c?esc(c):'الكل'}</button>`).join('')}</div><div id="lib">${draw('')}</div>`:empty())+'</div></section>';
  app.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{app.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x==b));document.getElementById('lib').innerHTML=draw(b.dataset.c)})},
async reports(p){if(p[1])return detail('reports',p[1]);const r=await pub('reports');app.innerHTML=head('reports')+(r.length?`<div class="grid">${r.map(x=>`<a class="card" href="/reports/${esc(x.slug)}">${img(x.cover_url)}<div class="bd"><span class="meta">${x.year||''}</span><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p></div><span class="arrow">←</span></a>`).join('')}</div>`:empty())+'</div></section>'},
async about(p){
  const years=(await db.from('club_years').select('year').order('year',{ascending:false}).then(ok)).map(y=>y.year),sc=await site();
  let Y=+p[1]||years[0],S=p[2]||'students';
  const units=Y?await db.from('structure_units').select('*').eq('year',Y).eq('section',S).then(ok):[];
  const asg=units.length?await db.from('assignments').select('unit_id,role_title,sort,members(full_name,photo_url,section)').in('unit_id',units.map(u=>u.id)).then(ok):[];
  const tree=(par,d)=>units.filter(u=>u.parent_id==par).sort((a,b)=>a.sort-b.sort).map(u=>`<div class="node"><h4>${esc(u.title)}</h4><div class="ppl">${asg.filter(a=>a.unit_id==u.id&&a.members).sort((a,b)=>a.sort-b.sort).map(a=>`<div class="person">${ava(a.members)}<div><b>${esc(a.members.full_name)}</b><span>${esc(a.role_title)}</span></div></div>`).join('')}</div>${tree(u.id,d+1)}</div>`).join('');
  app.innerHTML=`<section><div class="wrap"><div class="head"><h2>عن النادي</h2></div>${sc.about?body(sc.about):''}
  ${[['رؤية النادي','vision'],['رسالة النادي','mission'],['أهداف النادي','goals']].filter(x=>sc[x[1]]).map(x=>`<h3 style="margin-top:26px;color:var(--teal)">${x[0]}</h3>${body(sc[x[1]])}`).join('')}
  <div class="head" style="margin-top:50px"><h2>هيكلة النادي</h2></div>
  <div class="chips">${S&&['students','female_students'].map(s=>`<a class="chip${s==S?' on':''}" href="/about/${Y}/${s}">${s=='students'?'قسم الطلاب':'قسم الطالبات'}</a>`).join('')}</div>
  <div class="chips">${years.map(y=>`<a class="chip${y==Y?' on':''}" href="/about/${y}/${S}">${y}</a>`).join('')}</div>
  ${units.length?tree(null,0):empty()}</div></section>`},
async search(p){const q=p[1]||'',r=await db.rpc('search_content',{q}).then(ok);
  app.innerHTML=head('events').replace(TT.events,`نتائج البحث: ${esc(q)}`)+(r.length?r.map(x=>`<a class="card" style="margin-bottom:12px" href="/${['library','reports'].includes(x.kind)&&x.kind=='library'?'library':x.kind}/${x.kind=='library'?'':esc(x.slug)}"><div class="bd"><span class="meta">${TT[x.kind]}</span><h3>${esc(x.title)}</h3><p>${esc(x.snippet)}</p></div></a>`).join(''):'<p class="mute">لا نتائج مطابقة.</p>')+'</div></section>'}
};
async function detail(t,slug){
  const r=(await db.from(t).select('*').eq('slug',slug).eq('status','published').limit(1).then(ok))[0];
  if(!r){app.innerHTML='<div class="wrap"><p>لم يُعثر على الصفحة.</p></div>';return}
  document.title=r.title+' — نادي الدراسات القضائية والأنظمة';
  const H=`<div class="dh">${r.cover_url?`<img src="${esc(r.cover_url)}" alt="">`:''}<div class="wrap"><h1>${esc(r.title)}</h1></div></div>`;
  if(t=='events'){
    const B=(r.blocks&&r.blocks.length)?r.blocks:[{type:'text',text:r.body||''}];
    app.innerHTML=H+`<div class="ev"><p class="meta">${esc(fd(r.event_date))}${r.category?' · '+esc(r.category):''}${r.location?' · '+esc(r.location):''}</p>${B.map(b=>({
      text:()=>body(b.text),cutout:()=>`<img class="cut ${b.side=='start'?'start':''} ${b.size=='sm'?'s':b.size=='lg'?'l':''}" src="${esc(b.url)}" alt="">`,
      wide:()=>`<img class="wide" src="${esc(b.url)}" alt="">`,quote:()=>`<div class="q">${esc(b.text)}</div>`,
      gallery:()=>`<div class="gal">${(b.urls||[]).map(u=>`<img src="${esc(u)}" alt="" loading="lazy">`).join('')}</div>`}[b.type]||(()=>''))()).join('')}${atts(r)}<p style="clear:both;margin-top:30px">${share('events',r)}</p></div>`;
  }else if(t=='reports'){
    app.innerHTML=H+`<div class="dt"><p class="meta">${r.year||''}</p>${body(r.description)}<div class="kv">${(r.highlights||[]).map(h=>`<span><b>${esc(h.value)}</b>${esc(h.label)}</span>`).join('')}</div>${(r.contents||[]).length?`<h3>أبرز ما يتضمنه التقرير</h3><ul>${r.contents.map(c=>`<li>${esc(c)}</li>`).join('')}</ul>`:''}${atts(r)}<p style="margin-top:20px">${dl(r.file_url)}</p></div>`;
  }else{
    const rel=t=='articles'?(await pub('articles',4)).filter(x=>x.id!=r.id).slice(0,3):[];
    app.innerHTML=H+`<div class="dt"><p class="meta">${esc(fd(r.news_date||r.published_at))}</p>${t=='articles'?`<p class="mute">${r.author?'الكاتب: '+esc(r.author):''}${r.reviewer?' — المدقق: '+esc(r.reviewer):''}</p>`:''}${body(r.body)}${atts(r)}<div class="row" style="margin-top:28px">${dl(r.file_url)||'<span></span>'}${share(t,r)}</div></div>`+(rel.length?`<section><div class="wrap"><div class="head"><h2>مقالات ذات صلة</h2></div><div class="grid">${rel.map(artCard).join('')}</div></div></section>`:'');
  }
}
async function joinSec(){
  const yr=(await db.from('club_years').select('year').order('year',{ascending:false}).limit(1).then(ok))[0],
  cm=yr?await db.from('structure_units').select('title').eq('year',yr.year).eq('kind','لجنة').then(ok):[];
  return `<section id="join"><div class="wrap join"><div><h2 style="font-size:34px;margin-bottom:12px">انضم إلى النادي</h2><p>نرحّب بانضمامك إلى نادي الدراسات القضائية والأنظمة — عبّئ البيانات التالية وسنتواصل معك خلال أسبوع.</p></div>
  <form id="jf"><label class="f w">الاسم الثلاثي *<input name="full_name" required></label><label class="f">الرقم الجامعي *<input name="university_id" required inputmode="numeric"></label><label class="f">البريد الجامعي *<input name="university_email" type="email" required></label><label class="f">رقم الجوال *<input name="phone" type="tel" required></label><label class="f">الكلية *<input name="college" required></label>
  <label class="f w">اللجنة المطلوبة *<input name="committee" list="cl" required><datalist id="cl">${[...new Set(cm.map(c=>c.title))].map(c=>`<option value="${esc(c)}">`).join('')}</datalist></label>
  <label class="f w">لماذا ترغب بالانضمام إلى النادي؟ *<textarea name="reason" rows="3" required></textarea></label><label class="f w">ما هي خبراتك أو مشاريعك السابقة ذات الصلة؟<textarea name="experience" rows="3"></textarea></label><label class="f w">حساب LinkedIn (اختياري)<input name="linkedin" type="url"></label>
  <div class="f w">السيرة الذاتية (CV) (اختياري)<div class="drop" id="dz">اسحب الملف هنا أو انقر للرفع<br><small>PDF أو Word، حتى ١٠ ميغابايت</small></div><input type="file" id="cv" hidden accept=".pdf,.doc,.docx"></div>
  <p class="safe">بياناتك آمنة. لن تُشارك مع جهات خارجية.</p><button type="reset" class="btn" style="color:var(--ink)">إلغاء</button><button class="btn g">إرسال</button></form></div></section>`;
}
document.addEventListener('submit',async e=>{if(e.target.id!='jf')return;e.preventDefault();const f=e.target,o=Object.fromEntries(new FormData(f)),file=document.getElementById('cv').files[0];
  try{if(file){if(file.size>10485760)return toast('حجم الملف أكبر من ١٠ ميغابايت');const ext=file.name.split('.').pop().toLowerCase();o.cv_path=`join/${crypto.randomUUID()}.${ext}`;const u=await db.storage.from('cvs').upload(o.cv_path,file);if(u.error)throw u.error}
  for(const k in o)if(o[k]==='')delete o[k];const r=await db.from('join_requests').insert(o);if(r.error)throw r.error;f.reset();toast('تم استلام طلبك')}catch(err){console.error(err);toast('تعذّر الإرسال، حاولي مرة أخرى')}});
document.addEventListener('click',e=>{const d=e.target.closest('#dz');if(d){const i=document.getElementById('cv');i.click();i.onchange=()=>{if(i.files[0])d.textContent=i.files[0].name}}});
async function route(){const p=location.hash.replace(/^#\/?/,'').split('/').filter(Boolean).map(decodeURIComponent);document.body.dataset.r=p[0]||'home';app.innerHTML='<div class="wrap"><p class="mute">جارٍ التحميل…</p></div>';
  try{await(pages[p[0]||'home']||pages.home)(p);carDots()}catch(err){console.error(err);app.innerHTML='<div class="wrap"><p>تعذّر تحميل المحتوى. تأكدي من إعدادات الاتصال بقاعدة البيانات.</p></div>'}scrollTo(0,0)}
const go=u=>{const h='#'+u;if(location.hash===h)route();else location.hash=h};
addEventListener('hashchange',route);
document.addEventListener('click',e=>{const a=e.target.closest('a[href^="/"]');if(a&&!e.metaKey&&!e.ctrlKey&&a.target!='_blank'){e.preventDefault();go(a.getAttribute('href'))}});
if(!location.hash&&location.pathname.length>1&&!/\/(index|404)\.html$/.test(location.pathname)&&!/\/$/.test(location.pathname)){location.replace('/#'+location.pathname+location.search)}else route();foot();
</script>
<script>window.addEventListener('error',e=>{var t=document.getElementById('toast');if(t&&e.message&&!/Supabase keys/.test(e.message)){t.textContent='خطأ: '+e.message;t.classList.add('on');t.style.display='block'}})</script></body>
</html>
